#!/usr/bin/env bash
# Versioned pre-commit hook for 0 Mkt (SIP - Marketing): fast, deterministic checks only (a few seconds).
# Activate once per clone: git config core.hooksPath .githooks
# The kit checks run the scripts of 0 Padrões (next to this repo, or SUPER_IA_PROJECTS_PATH); without the kit they are skipped with a notice.
# The personal-path check is local to this repo and always runs.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
PY="python3"; command -v python3 >/dev/null 2>&1 || PY="python"
KIT="${SUPER_IA_PROJECTS_PATH:-$(cd .. 2>/dev/null && pwd)/0 Padrões}/.agents/scripts"
failed=0
run_check() {
  local label="$1"; shift
  local out
  if ! out=$("$@" 2>&1); then
    echo "pre-commit: $label failed" >&2
    echo "$out" >&2
    failed=1
  fi
}

run_check "personal paths (check_personal_paths.py)" "$PY" .agents/scripts/check_personal_paths.py --staged
if [ -d "$KIT" ]; then
  run_check "rule-file parity (sync_rules.py --check)" "$PY" "$KIT/sync_rules.py" --check
  run_check "AI entrypoints (sync_entrypoints.py --check)" "$PY" "$KIT/sync_entrypoints.py" --check
  run_check "SIP hub (check_sip_hub.py)" "$PY" "$KIT/check_sip_hub.py" . sip-marketing
else
  echo "pre-commit: kit scripts not found at $KIT; kit checks skipped" >&2
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: commit refused. Fix the items above (sync_rules.py, sync_entrypoints.py, build_sip_index.py --hub .)." >&2
  exit 1
fi
exit 0
