# ==============================================================================
# SUPER IA PROJECTS - MARKETING
# Arquivo de configuração de chaves de API e variáveis de ambiente
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as chaves das plataformas que você utiliza.
# ==============================================================================

# ==============================================================================
# 1. MODELOS DE LINGUAGEM, RACIOCÍNIO & CHAT (LLMs & AGENTES)
# ==============================================================================
# Google Gemini / Google AI Studio (Modelos: Gemini 2.0 Flash, 1.5 Pro, Flash Thinking)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenRouter (Roteador unificado para Claude 3.5, DeepSeek R1/V3, Llama 3, Qwen, etc.)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (Modelos: GPT-4o, GPT-4o-mini, o1, o3-mini)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Claude 3.7 Sonnet direto)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# xAI / Grok (Grok-2, Grok-3, Aurora)
# Obtenha em: https://console.x.ai/
XAI_API_KEY=

# Groq (Inferência de altíssima velocidade para Whisper e Llama)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face (Modelos open-source e diarização)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=


# ==============================================================================
# 2. GERAÇÃO DE IMAGEM & DESIGN COM IA
# ==============================================================================
# Fal.ai Gateway (FLUX.1 Schnell/Dev/Pro, FLUX.2, Recraft, SDXL, Ideogram)
# Gateway unificado de difusão de altíssima velocidade
# Obtenha em: https://fal.ai/dashboard/keys
FAL_KEY=
FAL_AI_API_KEY=

# Black Forest Labs - FLUX API Oficial (FLUX.2 [pro], [max], [flex], [klein])
# Utilizado pela skill audiovisual-imagem-flux-api
# Obtenha em: https://dashboard.bfl.ai/get-started
BFL_API_KEY=

# Stability AI (Stable Diffusion 3.5, SDXL, Ultra)
# Obtenha em: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Replicate (Acesso a dezenas de modelos de geração e refino visual)
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Higgsfield AI / Midjourney Wrappers
HIGGSFIELD_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=


# ==============================================================================
# 3. GERAÇÃO, ANIMAÇÃO & AVATARES DE VÍDEO COM IA
# ==============================================================================
# Runway (Runway Gen-3 Alpha, Gen-4 - vídeo cinematográfico)
# Obtenha em: https://app.runwayml.com/
RUNWAY_API_KEY=
RUNWAYML_API_SECRET=

# HeyGen (Criação de vídeos com avatares realistas, tradução e dublagem de vídeo)
# Obtenha em: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# Luma Dream Machine (Vídeos de alta fidelidade e física realista)
# Obtenha em: https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=

# Kling AI (Vídeos dinâmicos até 1080p com alta coerência de movimento)
KLING_API_KEY=

# MiniMax Hailuo AI (Vídeos ultra fluidos)
MINIMAX_API_KEY=

# Google DeepMind Veo (Vídeo generativo do Google AI)
VEO_API_KEY=

# Pika Labs
PIKA_API_KEY=

# Configuração de Vídeo Local (opcional caso utilize GPUs locais com diffusers)
VIDEO_GEN_LOCAL_ENABLED=false
VIDEO_GEN_LOCAL_MODEL=wan2.1-1.3b
MODAL_LTX2_ENDPOINT_URL=


# ==============================================================================
# 4. VOZ, LOCUÇÃO, MÚSICA & EFEITOS SONOROS (ÁUDIO)
# ==============================================================================
# ElevenLabs (Clonagem de voz, Text-to-Speech de estúdio, Sound Effects, Dubbing)
# Obtenha em: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Suno AI (Geração de músicas completas com instrumentos e vocais)
SUNO_API_KEY=

# Freesound.org (Biblioteca aberta de efeitos sonoros e ruídos ambientes)
# Obtenha em: https://freesound.org/help/developers/
FREESOUND_API_KEY=


# ==============================================================================
# 5. BANCOS DE MÍDIA GRATUITOS & STOCK ASSETS (IMAGENS E VÍDEOS B-ROLL)
# ==============================================================================
# Pexels (Stock videos e fotos em alta resolução - Grátis)
# Obtenha em: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay (Vídeos e fotos royalty-free - Grátis)
# Obtenha em: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash (Fotografias artísticas em altíssima resolução - Grátis)
# Obtenha em: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=


# ==============================================================================
# 6. MARKETING INTELLIGENCE, SEO & WEB RESEARCH
# ==============================================================================
# Firecrawl Cloud API (Scraping de sites e conversão em markdown para IA)
# Obtenha em: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# SemRush (Análise de palavras-chave, tráfego orgânico e concorrência)
SEMRUSH_API_KEY=

# Ahrefs (Auditoria de backlinks e análise de SEO)
AHREFS_API_KEY=

# SerpAPI (Buscas e dados estruturados em tempo real do Google)
# Obtenha em: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
